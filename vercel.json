{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://datapay.onrender.com/api/:path*"
    },
    {
      "source": "/events/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/event/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/tickets/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/ticket/:path*",
      "destination": "/index.html"
    }
  ]
}



